ENVIRONMENT='development'
MODE='dynamic'

NATS_URL='nats://localhost:4222'
AQUILA_URL='http://localhost:50051'
AQUILA_TOKEN='token'

WITH_HEALTH_SERVICE=false
GRPC_HOST='127.0.0.1'
GRPC_PORT=50051

DEFINITIONS='./definitions'
RUNTIME_STATUS_UPDATE_INTERVAL_SECONDS=30
AQUILA_GRPC_CONNECT_TIMEOUT_SECS=2
AQUILA_GRPC_REQUEST_TIMEOUT_SECS=10

EXECUTION_RESULT_SAMPLE_RATE=1.0
RUNTIME_USAGE_STREAM='runtime_usage'
RUNTIME_USAGE_BATCH_SIZE=1000
RUNTIME_USAGE_FLUSH_INTERVAL_MS=1000
RUNTIME_USAGE_BUFFER_CAPACITY=100000
